# ==============================================================================
# Trendy Looms — Environment Variables Template (.env.example)
# Copy this file to .env or configure these variables in your hosting provider (e.g. Vercel)
# ==============================================================================

# --- Core Django Settings ---
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-django-key-here

# 1 for local development, 0 for production
DJANGO_DEBUG=1

# Comma-separated list of allowed host domains
DJANGO_ALLOWED_HOSTS=class-training.vercel.app,localhost,127.0.0.1

# Comma-separated list of CSRF trusted origins
DJANGO_CSRF_TRUSTED_ORIGINS=https://class-training.vercel.app,http://127.0.0.1:8000

# --- Database Configuration ---
# Optional: PostgreSQL / MySQL connection string (e.g. Supabase, Neon, Railway)
# If left empty, SQLite in /tmp (Vercel) or db.sqlite3 (Local) is used automatically.
# DATABASE_URL=postgres://username:password@hostname:5432/dbname

# --- Razorpay Payment Gateway ---
# Get these keys from your Razorpay Dashboard: Settings -> API Keys
RAZORPAY_API_KEY=rzp_test_your_key_id_here
RAZORPAY_API_SECRET=your_razorpay_secret_key_here
